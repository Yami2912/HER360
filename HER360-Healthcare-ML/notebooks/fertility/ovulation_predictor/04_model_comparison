        "rows = []\n",
        "for name in [\"calendar_offset\", \"linear_regression\", \"random_forest\", \"gradient_boosting\"]:\n",
        "    m = models[name]\n",
        "    oof = cross_val_predict(m, X_tr, y_tr, cv=gkf, groups=groups)\n",
        "    q80 = float(np.quantile(np.abs(y_tr - oof), 0.80))      # half-width of the range\n",
        "    m.fit(X_tr, y_tr)\n",
        "    inside = np.abs(y_va - m.predict(X_va)) <= q80\n",
        "    rows.append({\"model\": name, \"range_half_width_days\": round(q80, 2),\n",
        "                 \"target_coverage_%\": 80, \"validation_coverage_%\": round(100 * inside.mean(), 1)})\n",
        "intervals = pd.DataFrame(rows)\n",
        "display(intervals)"

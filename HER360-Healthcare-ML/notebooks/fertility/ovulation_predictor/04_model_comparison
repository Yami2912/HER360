    {
      "cell_type": "code",
      "source": [
        "import pandas as pd, numpy as np, warnings\n",
        "import matplotlib.pyplot as plt\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "pd.set_option(\"display.width\", 200)\n",
        "\n",
        "sys.path.insert(0, str(BASE / \"preprocessing/fertility\"))\n",
        "import ovulation_prep as op\n",
        "\n",
        "T, G = op.TARGET, op.GROUP\n",
        "F = op.FEATURES_V1          # the frozen v1 feature list\n",
        "print(\"features:\", F)\n",
        "\n",
        "df = pd.read_csv(BASE / \"datasets/fertility/ovulation_predictor/processed/ovulation_model_table_v1.csv\")\n",
        "\n",
        "# train + validation only. The TEST split is deliberately not loaded.\n",
        "tr = df[(df.split == \"train\")      & (df.n_prev_cycles >= 1)].reset_index(drop=True)\n",
        "va = df[(df.split == \"validation\") & (df.n_prev_cycles >= 1)].reset_index(drop=True)\n",
        "\n",
        "X_tr, y_tr, groups = tr[F], tr[T], tr[G]\n",
        "X_va, y_va = va[F], va[T]\n",
        "print(\"train rows:\", len(tr), \"| participants:\", tr[G].nunique(), \"| validation rows:\", len(va))"
      ],
      "metadata": {
        "id": "2BFrQ5EONy9W"
      },
      "execution_count": null,

    {
      "cell_type": "code",
      "source": [
        "from sklearn.model_selection import GroupKFold, cross_val_predict\n",
        "\n",
        "gkf = GroupKFold(n_splits=5)\n",
        "rows = []\n",
        "for name, m in models.items():\n",
        "    oof = cross_val_predict(m, X_tr, y_tr, cv=gkf, groups=groups)          # out-of-fold predictions\n",
        "    fold_mae = [np.abs(y_tr.iloc[i] - oof[i]).mean() for _, i in gkf.split(X_tr, y_tr, groups)]\n",
        "\n",
        "    m.fit(X_tr, y_tr)\n",
        "    err_va = np.abs(y_va - m.predict(X_va))\n",
        "    rows.append({\n",
        "        \"model\": name,\n",
        "        \"cv_MAE\": np.mean(np.abs(y_tr - oof)),\n",
        "        \"cv_fold_std\": np.std(fold_mae),\n",
        "        \"val_MAE\": err_va.mean(),\n",
        "        \"val_within_1_%\": 100 * (err_va <= 1).mean(),\n",
        "        \"val_within_2_%\": 100 * (err_va <= 2).mean(),\n",
        "    })\n",
        "\n",
        "results = pd.DataFrame(rows).round(2)\n",
        "display(results)"
      ],

    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.base import BaseEstimator, RegressorMixin\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\n",
        "\n",
        "class GlobalMedian(BaseEstimator, RegressorMixin):\n",
        "    \"\"\"Always predict the training median.\"\"\"\n",
        "    def fit(self, X, y):\n",
        "        self.m_ = float(np.median(y)); return self\n",
        "    def predict(self, X):\n",
        "        return np.full(len(X), self.m_)\n",
        "\n",
        "class CalendarOffset(BaseEstimator, RegressorMixin):\n",
        "    \"\"\"prev_cycle_mean + offset, where offset is learned from the training fold.\"\"\"\n",
        "    def fit(self, X, y):\n",
        "        self.offset_ = float(np.median(np.asarray(y) - X[\"prev_cycle_mean\"].to_numpy())); return self\n",
        "    def predict(self, X):\n",
        "        return X[\"prev_cycle_mean\"].to_numpy() + self.offset_\n",
        "\n",
        "def imputer():\n",
        "    return SimpleImputer(strategy=\"median\", add_indicator=True)\n",
        "\n",
        "models = {\n",
        "    \"global_median\":     GlobalMedian(),\n",
        "    \"calendar_offset\":   CalendarOffset(),\n",
        "    \"linear_regression\": make_pipeline(imputer(), LinearRegression()),\n",
        "    \"random_forest\":     make_pipeline(imputer(), RandomForestRegressor(\n",
        "                             n_estimators=300, min_samples_leaf=10, max_features=0.7,\n",
        "                             random_state=42, n_jobs=-1)),\n",
        "    \"gradient_boosting\": make_pipeline(imputer(), GradientBoostingRegressor(\n",
        "                             n_estimators=150, learning_rate=0.03, max_depth=2,\n",
        "                             subsample=0.8, min_samples_leaf=10, random_state=42)),\n",
        "}\n",
        "print(list(models))"
      ],
